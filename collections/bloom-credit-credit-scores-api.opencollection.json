{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloom Credit Consumers Credit Scores API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Credit Scores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bloom Credit Get Credit Scores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bloomcredit.io/v1/consumers/:consumer_id/scores",
            "params": [
              {
                "name": "consumer_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the consumer."
              },
              {
                "name": "bureaus",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of bureaus."
              },
              {
                "name": "score_type",
                "value": "",
                "type": "query",
                "description": "Score model type (e.g., FICO8, VANTAGE3)."
              }
            ]
          },
          "docs": "Retrieves credit scores for the consumer from specified bureaus."
        }
      ]
    }
  ],
  "bundled": true
}