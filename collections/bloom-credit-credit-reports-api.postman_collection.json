          "id": "4e891a7b-7e1e-46ed-b201-3970cd6d77b1",
          "name": "Bloom Credit Get Credit Reports",
          "request": {
            "name": "Bloom Credit Get Credit Reports",
            "description": {
              "content": "Retrieves credit reports for the specified consumer from one or more credit bureaus. Returns structured trade line, inquiry, and public record data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "consumers",
                ":consumer_id",
                "credit-reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bureaus",
                  "value": "<string>",
                  "description": "Comma-separated list of bureaus (equifax,experian,transunion). Defaults to all three."
                },
                {
                  "disabled": false,
                  "key": "refresh",
                  "value": "<boolean>",
                  "description": "If true, pulls a fresh report from the bureau."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "consumer_id",
                  "description": "(Required) Unique identifier for the consumer."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
